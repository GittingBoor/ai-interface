{
  "name": "ai-interface",
  "productName": "AI Interface",
  "version": "0.1.0",
  "description": "Desktop-App zur Verwaltung der KI-Arbeit: Verbrauch, Projekte, Claude-Terminals, Modelle, TODOs, Protokolle",
  "main": "./out/main/index.js",
  "author": "GittingBoor",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:web": "vite --config vite.web.config.ts",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "node scripts/run-tests.mjs",
    "postinstall": "node scripts/postinstall.mjs",
    "dist:win": "npm run build && electron-builder --win",
    "dist:linux": "npm run build && electron-builder --linux"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ssh2": "^1.15.6",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.283",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/mona-sans": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "better-sqlite3": "^13.0.3",
    "dompurify": "^3.4.16",
    "electron-log": "^5.4.4",
    "lucide-react": "^1.48.0",
    "marked": "^18.0.14",
    "motion": "^13.4.4",
    "node-pty": "^1.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-resizable-panels": "^4.14.1",
    "ssh2": "^1.17.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "engines": {
    "node": ">=22"
  }
}
